# Export these values in your shell before starting the backend.
# Both servers bind to loopback. Open http://localhost:5173 in the browser.
CHAT_ADDRESS=127.0.0.1:8080
CHAT_ORIGINS=http://localhost:5173
CHAT_MAX_CONNECTIONS=500
CHAT_MAX_CONNECTIONS_PER_IP=5
CHAT_QUEUE_CAPACITY=500
CHAT_COMMAND_BUFFER=256
CHAT_OUTBOUND_BUFFER=32
CHAT_FRAME_BYTES=8192
CHAT_MESSAGE_CHARACTERS=2000
CHAT_MESSAGE_BYTES=8000
# Durations use Go units: ms, s, m.
CHAT_PING_INTERVAL=25s
CHAT_PONG_WAIT=60s
CHAT_WRITE_WAIT=10s
CHAT_HANDSHAKE_TIMEOUT=5s
CHAT_READ_HEADER_TIMEOUT=5s
CHAT_QUEUE_WAIT=120s
CHAT_SHUTDOWN_TIMEOUT=10s
CHAT_HANDSHAKE_BURST=10
CHAT_HANDSHAKES_PER_MINUTE=10
CHAT_IP_LIMITER_TTL=10m
CHAT_IP_LIMITER_ENTRIES=10000
# Optional Vite proxy target; browser sockets still use the browser origin.
CHAT_PROXY_TARGET=http://127.0.0.1:8080
